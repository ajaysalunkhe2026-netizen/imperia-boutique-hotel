# Supabase project settings (obtain from the approved project dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Never add service-role or secret keys to NEXT_PUBLIC_* variables.
# Keep server-only secrets in deployment environment settings, not Git.
